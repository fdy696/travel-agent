                                              AIMessage(content='确实，联网搜索和地图查询工具当前都不可用。让我再尝试一次搜索，确认是否只是暂时性的问题。', additional_kwargs={'refusal': None}, response_metadata={'token_usage': {'completion_tokens': 108, 'prompt_tokens': 9750, 'total_tokens': 9858, 'completion_tokens_details': None, 'prompt_tokens_details': {'audio_tokens': None, 'cache_write_tokens': None, 'cached_tokens': 1664}, 'prompt_cache_hit_tokens': 1664, 'prompt_cache_miss_tokens': 8086}, 'model_provider': 'deepseek', 'model_name': 'deepseek-v4-flash', 'system_fingerprint': 'fp_a18b46594c_prod0820_fp8_kvcache_20260402', 'id': '893bc018-cdae-41c7-91fe-6c36fa230fb6', 'finish_reason': 'tool_calls', 'logprobs': None}, name='travel_agent', id='lc_run--019fe608-f760-7023-b5af-837fb7fbb25d-0', tool_calls=[{'name': 'search_travel_info', 'args': {'query': '浅草寺 开放时间 门票'}, 'id': 'call_00_BoRdybtj0MB4L3AYh6qn5113', 'type': 'tool_call'}, {'name': 'get_weather', 'args': {'city': '东京'}, 'id': 'call_01_SW5wjg8mELUcGpOQ5zmz9218', 'type': 'tool_call'}], invalid_tool_calls=[], usage_metadata={'input_tokens': 9750, 'output_tokens': 108, 'total_tokens': 9858, 'input_token_details': {'cache_read': 1664}, 'output_token_details': {}}),
