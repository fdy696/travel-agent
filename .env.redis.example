# Conversation / LangGraph checkpoint persistence
REDIS_URL=redis://localhost:6379
REDIS_CHECKPOINT_PREFIX=travel-agent:checkpoint
REDIS_CHECKPOINT_WRITE_PREFIX=travel-agent:checkpoint_write

# 留空 = checkpoint 不自动过期。
# 如果未来决定会话只保留 7 天，可设置：10080
# REDIS_CHECKPOINT_TTL_MINUTES=10080
REDIS_CHECKPOINT_REFRESH_ON_READ=true
