# ---- Model ----
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
TRAVEL_TIMEZONE=Asia/Shanghai

# ---- Search ----
TAVILY_API_KEY=

# ---- QWeather ----
# 2026 起 QWeather 推荐使用账号专属 API Host，例如:
# abc1234xyz.def.qweatherapi.com
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# ---- AMap ----
AMAP_API_KEY=

# ---- Redis Checkpointer ----
REDIS_URL=redis://localhost:6379
REDIS_CHECKPOINT_PREFIX=travel-agent:checkpoint
REDIS_CHECKPOINT_WRITE_PREFIX=travel-agent:checkpoint_write
REDIS_CHECKPOINT_REFRESH_ON_READ=true
# 留空表示不自动过期；例如 10080 表示 7 天。
REDIS_CHECKPOINT_TTL_MINUTES=

# ---- SQLite business state ----
# 留空则默认写入 .data/travel_agent.db
# TRAVEL_PLANNING_DB=.data/travel_agent.db
