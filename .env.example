# development: DuckDuckGo only (free; never calls Tavily)
# test:        FakeSearch only (offline)
# production:  Tavily -> DuckDuckGo fallback
APP_ENV=development
APP_DEBUG=true

# LangGraph single-run super-step safety limit
AGENT_RECURSION_LIMIT=80

# Model provider is independent from APP_ENV: deepseek | ollama
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash

# Used only when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Free reference FX API (no key required)
FX_BASE_URL=https://api.frankfurter.dev/v2

# Only used as primary web search when APP_ENV=production
TAVILY_API_KEY=

QWEATHER_API_KEY=
AMAP_API_KEY=
